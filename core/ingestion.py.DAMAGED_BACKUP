# ============================================================
# DOCUMENT RETRIEVAL
# ============================================================

def search_documents(
    query,
    embedder=None,
    state=None,
    top_k=5
):
    """
    Retrieve the most relevant document chunks using FAISS.
    """

    if not query:
        return []

    if state is None:
        state = {}

    chunks = state.get("chunks", [])
    index = state.get("faiss_index")

    if embedder is None:
        embedder = state.get("embedder")

    if not chunks:
        return []

    if index is None:
        return []

    if embedder is None:
        raise ValueError("Embedding model is not available.")

    # Create query embedding
    query_vector = embedder.encode(
        [query],
        convert_to_numpy=True,
        show_progress_bar=False
    )

    query_vector = np.asarray(
        query_vector,
        dtype=np.float32
    )

    if query_vector.ndim == 1:
        query_vector = query_vector.reshape(1, -1)

    # Search FAISS
    scores, indices = index.search(
        query_vector,
        min(top_k, len(chunks))
    )

    results = []

    for rank, (score, idx) in enumerate(
        zip(scores[0], indices[0]),
        start=1
    ):

        if idx < 0 or idx >= len(chunks):
            continue

        item = chunks[idx]

        if isinstance(item, dict):
            text_value = str(
                item.get("text", "")
            )

            source = str(
                item.get(
                    "source",
                    item.get(
                        "filename",
                        "Unknown source"
                    )
                )
            )

        else:
            text_value = str(item)
            source = "Unknown source"

        results.append({
            "rank": rank,
            "source": source,
            "text": text_value,
            "score": float(score)
        })

    return results

