import os
import subprocess
import re


MODEL_PATH = os.path.abspath(
    os.path.join(
        os.path.dirname(__file__),
        "..",
        "models",
        "mistral-7b-instruct-v0.2.Q4_K_M.gguf"
    )
)

LLAMA_PATH = os.path.abspath(
    os.path.join(
        os.path.dirname(__file__),
        "..",
        "llama_cpp_local",
        "llama-cli.exe"
    )
)


SYSTEM_PROMPT = (
    "You are an offline document question-answering assistant. "
    "Answer ONLY using the provided context. "
    "If the answer is not present in the context, say exactly: "
    "\"I couldn't find this information in the provided documents.\" "
    "Do not use outside knowledge."
)


def generate_answer(question, context=""):
    """
    Generate one answer using the local Mistral model.
    """

    if context:
        prompt = (
            "Use ONLY the following document context to answer the question. "
            "Do not use outside knowledge. "
            "If the answer is not present in the context, say: "
            "I couldn't find this information in the provided documents. "
            "Answer briefly.\\n\\n"
            "DOCUMENT CONTEXT:\\n"
            + str(context)
            + "\\n\\n"
            "QUESTION: "
            + str(question)
            + "\\n"
            "ANSWER:"
        )
    else:
        prompt = str(question)

    command = [
        LLAMA_PATH,
        "-m", MODEL_PATH,
        "-ngl", "99",
        "-p", prompt,
        "-n", "32",
        "--temp", "0.2",
        "--no-display-prompt",
        "--single-turn"
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="ignore",
        timeout=60
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or
            "Mistral inference failed."
        )

    output = result.stdout.strip()

    # The llama-cli build can return its interactive banner.
    # Find the actual generated answer after the final ANSWER marker.
    marker = "ANSWER:"
    if marker in output:
        output = output.rsplit(marker, 1)[-1].strip()

    # Remove CLI metadata.
    if "[ Prompt:" in output:
        output = output.split("[ Prompt:", 1)[0].strip()

    if "Exiting..." in output:
        output = output.split("Exiting...", 1)[0].strip()

    return output.strip()

def answer_from_retrieval(question, results):

    if not results:
        return (
            "I couldn't find this information in the "
            "provided documents."
        )

    context_parts = []

    for result in results:

        source = result.get(
            "source",
            "Unknown"
        )

        text = result.get(
            "text",
            ""
        )

        if not text:
            continue

        context_parts.append(
            f"[Source: {source}]\n{text}"
        )

    context = "\n\n".join(
        context_parts
    )

    return generate_answer(
        question,
        context
    )