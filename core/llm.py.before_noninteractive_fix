import os
import subprocess


MODEL_PATH = os.path.abspath(
    os.path.join(
        os.path.dirname(__file__),
        "..",
        "models",
        "mistral-7b-instruct-v0.2.Q4_K_M.gguf"
    )
)

LLAMA_PATH = os.path.abspath(
    os.path.join(
        os.path.dirname(__file__),
        "..",
        "llama_cpp_local",
        "llama-cli.exe"
    )
)


SYSTEM_PROMPT = (
    "You are an offline document question-answering assistant. "
    "Answer ONLY using the provided context. "
    "If the answer is not present in the context, say exactly: "
    "\"I couldn't find this information in the provided documents.\" "
    "Do not use outside knowledge."
)


def generate_answer(question, context=""):
    """
    Generate a single grounded answer using the local Mistral model.
    """

    prompt = (
        "Context:\n"
        + str(context)
        + "\n\n"
        "Question:\n"
        + str(question)
        + "\n\n"
        "Answer:"
    )

    command = [
        LLAMA_PATH,
        "-m", MODEL_PATH,
        "-ngl", "99",
        "-st",
        "-sys", SYSTEM_PROMPT,
        "-p", prompt,
        "-n", "256",
        "--temp", "0.2",
        "--no-display-prompt"
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="ignore",
        timeout=180
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or
            "Mistral inference failed."
        )

    output = result.stdout.strip()

    if "Answer:" in output:
        output = output.split("Answer:", 1)[-1].strip()

    if "[ Prompt:" in output:
        output = output.split("[ Prompt:", 1)[0].strip()

    if "Exiting..." in output:
        output = output.split("Exiting...", 1)[0].strip()

    # Remove accidental continuation generated by the model.
    # Keep only the first answer.
    lines = output.splitlines()
    cleaned = []

    for line in lines:
        stripped = line.strip()

        if stripped.lower().startswith("question:"):
            break

        if stripped.lower().startswith("user question:"):
            break

        cleaned.append(line)

    output = "\n".join(cleaned).strip()

    # Remove an unnecessary leading Answer: label.
    if output.lower().startswith("answer:"):
        output = output[7:].strip()

    return output

def answer_from_retrieval(question, results):

    if not results:
        return (
            "I couldn't find this information in the "
            "provided documents."
        )

    context_parts = []

    for result in results:

        source = result.get(
            "source",
            "Unknown"
        )

        text = result.get(
            "text",
            ""
        )

        if not text:
            continue

        context_parts.append(
            f"[Source: {source}]\n{text}"
        )

    context = "\n\n".join(
        context_parts
    )

    return generate_answer(
        question,
        context
    )