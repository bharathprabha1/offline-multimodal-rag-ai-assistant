import os
import subprocess


MODEL_PATH = os.path.abspath(
    os.path.join(
        os.path.dirname(__file__),
        "..",
        "models",
        "mistral-7b-instruct-v0.2.Q4_K_M.gguf"
    )
)

LLAMA_PATH = os.path.abspath(
    os.path.join(
        os.path.dirname(__file__),
        "..",
        "llama_cpp_local",
        "llama-cli.exe"
    )
)


SYSTEM_PROMPT = (
    "You are an offline document question-answering assistant. "
    "Answer ONLY using the provided context. "
    "If the answer is not present in the context, say exactly: "
    "\"I couldn't find this information in the provided documents.\" "
    "Do not use outside knowledge."
)


def generate_answer(question, context=""):
    """
    Generate a single non-interactive answer using the local Mistral model.
    """

    prompt = (
        "You are an offline document question-answering assistant.\n"
        "Answer the user's question using ONLY the provided context.\n"
        "Do not invent information.\n"
        "Give one concise, direct answer.\n"
        "If the answer is present in the context, state it naturally.\n"
        "Mention the source filename when it is available in the context.\n\n"
        "Context:\n"
        + str(context)
        + "\n\n"
        "Question:\n"
        + str(question)
        + "\n\n"
        "Answer:"
    )

    command = [
        LLAMA_PATH,
        "-m", MODEL_PATH,
        "-ngl", "99",
        "-p", prompt,
        "-n", "256",
        "--temp", "0.2",
        "--no-display-prompt"
    ]

    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="ignore"
    )

    if result.returncode != 0:
        raise RuntimeError(
            result.stderr.strip() or
            "Mistral inference failed."
        )

    output = result.stdout.strip()

    if "Answer:" in output:
        output = output.split("Answer:", 1)[-1].strip()

    if "[ Prompt:" in output:
        output = output.split("[ Prompt:", 1)[0].strip()

    if "Exiting..." in output:
        output = output.split("Exiting...", 1)[0].strip()

    return output.strip()

def answer_from_retrieval(question, results):

    if not results:
        return (
            "I couldn't find this information in the "
            "provided documents."
        )

    context_parts = []

    for result in results:

        source = result.get(
            "source",
            "Unknown"
        )

        text = result.get(
            "text",
            ""
        )

        if not text:
            continue

        context_parts.append(
            f"[Source: {source}]\n{text}"
        )

    context = "\n\n".join(
        context_parts
    )

    return generate_answer(
        question,
        context
    )